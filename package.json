{
  "name": "slabwatch",
  "private": true,
  "description": "Study project: a mock marketplace of graded collectible cards on Solana devnet, with an optional AI shopping agent.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "prepare": "lefthook install || true",
    "bootstrap": "docker compose up -d --wait && pnpm db:migrate && pnpm db:seed",
    "dev": "pnpm --filter @slabwatch/server dev",
    "db:migrate": "pnpm --filter @slabwatch/server db:migrate",
    "db:seed": "pnpm --filter @slabwatch/server db:seed",
    "db:seed:large": "pnpm --filter @slabwatch/server db:seed:large",
    "tags:run": "pnpm --filter @slabwatch/server tags:run",
    "vectors:run": "pnpm --filter @slabwatch/server vectors:run",
    "bench:search": "pnpm --filter @slabwatch/server bench:search",
    "bench:engines": "pnpm --filter @slabwatch/server bench:engines",
    "search:sync": "pnpm --filter @slabwatch/server search:sync",
    "eval": "pnpm --filter @slabwatch/evals eval",
    "eval:search": "pnpm --filter @slabwatch/evals eval:search",
    "eval:rank": "pnpm --filter @slabwatch/evals eval:rank",
    "eval:fit": "pnpm --filter @slabwatch/evals eval:fit",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2"
  }
}
