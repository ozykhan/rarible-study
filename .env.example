# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Postgres with pgvector (docker compose up gives you this one)
DATABASE_URL=postgres://slabwatch:slabwatch@localhost:5432/slabwatch

# Anthropic API key for the agent, the want parser, the judge and card tags
ANTHROPIC_API_KEY=
# Model ids and prices (USD per million tokens) used by the cost meter
LLM_MODEL=claude-haiku-5-5
LLM_PRICE_INPUT_PER_MTOK=0.10
LLM_PRICE_OUTPUT_PER_MTOK=0.50
# Hard daily cap on model spend, in USD. Calls are refused once it is reached.
LLM_DAILY_CAP_USD=2

# Embeddings: "local" runs a small model in-process (no key); "hash" is a
# deterministic test embedder with no semantic meaning.
EMBEDDER=local
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5

# New-listing generator: seconds between generated listings (0 turns it off)
GENERATOR_INTERVAL_SECONDS=45

# Day 2: purchases, the agent and tracing
PURCHASE_DAILY_CAP_USD=500
DEMO_READ_ONLY=false
AGENT_ENABLED=false
AGENT_MAX_STEPS=6
WATCHER_INTERVAL_SECONDS=15
# Seconds between card tagger runs, which tag new or changed cards with the model (0 turns it off)
TAGGER_INTERVAL_SECONDS=600
# Traces over OTLP/HTTP, read from the standard OpenTelemetry variables.
# Railway sets these itself when tracing is on for the service. For Langfuse:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 of public_key:secret_key>
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# http/protobuf (default) or http/json
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=slabwatch-server

# Day 3: wallet and devnet payments
# "simulated" (default) or "devnet"
PAYMENTS=simulated
# A Solana devnet RPC. Any other cluster is refused before a transaction is sent.
# "memory" runs the same payment code on an in-process VM, with no network.
SOLANA_RPC_URL=https://api.devnet.solana.com
# 32 random bytes as hex (openssl rand -hex 32). The server's devnet keys are
# derived from it. Devnet only: never put a mainnet key anywhere near this.
DEVNET_SEED=
# Test dUSD a wallet gets from the faucet, once a day
FAUCET_USD=2000
# Browser origins allowed to call /api, comma separated
WEB_ORIGINS=http://localhost:3000
# Per IP and per wallet, per hour, for endpoints that cost a model call
COSTLY_REQUESTS_PER_HOUR=30

# The web app (apps/web) reads these at build time; both are public.
NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
