# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Postgres with pgvector (docker compose up gives you this one)
DATABASE_URL=postgres://slabwatch:slabwatch@localhost:5432/slabwatch

# Anthropic API key for the agent, the want parser and the judge
ANTHROPIC_API_KEY=
# Model ids and prices (USD per million tokens) used by the cost meter
LLM_MODEL=claude-haiku-5-5
LLM_PRICE_INPUT_PER_MTOK=0.10
LLM_PRICE_OUTPUT_PER_MTOK=0.50
# Hard daily cap on model spend, in USD. Calls are refused once it is reached.
LLM_DAILY_CAP_USD=2

# Embeddings: "local" runs a small model in-process (no key); "hash" is a
# deterministic test embedder with no semantic meaning.
EMBEDDER=local
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5

# New-listing generator: seconds between generated listings (0 turns it off)
GENERATOR_INTERVAL_SECONDS=45

# Day 2: purchases, the agent and tracing
PURCHASE_DAILY_CAP_USD=500
DEMO_READ_ONLY=false
AGENT_ENABLED=false
AGENT_MAX_STEPS=6
WATCHER_INTERVAL_SECONDS=15
# OTLP/HTTP traces, for example Langfuse: https://cloud.langfuse.com/api/public/otel/v1/traces
OTLP_TRACES_URL=
# Authorization=Basic <base64 of public_key:secret_key>
OTLP_HEADERS=
