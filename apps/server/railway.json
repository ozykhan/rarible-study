{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": ["apps/server/**", "packages/**", "pnpm-lock.yaml", "package.json"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @slabwatch/server start",
    "preDeployCommand": ["pnpm --filter @slabwatch/server db:seed"],
    "healthcheckPath": "/health",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
