{
  "name": "@slabwatch/server",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "db:seed:large": "tsx --env-file-if-exists=../../.env src/scripts/seed-large.ts",
    "tags:run": "tsx --env-file-if-exists=../../.env src/scripts/tag-cards.ts",
    "vectors:run": "tsx --env-file-if-exists=../../.env src/scripts/card-vectors.ts",
    "bench:search": "tsx --env-file-if-exists=../../.env src/scripts/bench-search.ts",
    "generate": "tsx --env-file-if-exists=../../.env src/scripts/generate.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "mint-token": "tsx --env-file-if-exists=../../.env src/scripts/mint-token.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.5.0",
    "@effect/platform-node": "4.1.2",
    "@effect/sql-pg": "4.1.2",
    "@huggingface/transformers": "4.3.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@slabwatch/domain": "workspace:*",
    "@slabwatch/seed": "workspace:*",
    "@solana-program/memo": "0.16.0",
    "@solana-program/system": "0.16.0",
    "@solana-program/token": "0.18.0",
    "@solana/kit": "8.6.0",
    "effect": "4.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.2",
    "litesvm": "1.6.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
